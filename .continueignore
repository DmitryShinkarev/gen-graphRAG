# Universal Continue.dev ignore file
# Excludes all problematic files that cause ByteString errors

# =============================================================================
# BINARY AND COMPILED FILES (Major cause of ByteString errors)
# =============================================================================

# Java compiled files
*.class
*.jar
*.war
*.ear
*.aar
*.apk
*.dex

# Python compiled files
*.pyc
*.pyo
*.pyd
*.so
*.pyd

# C/C++ compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Other binary files
*.bin
*.dat
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb

# =============================================================================
# ARCHIVE AND COMPRESSED FILES
# =============================================================================

*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz

