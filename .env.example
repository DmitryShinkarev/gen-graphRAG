# Java Unit Test Agent - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Default LLM provider (openai, qwen, anthropic)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Qwen Coder Configuration
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-coder
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=4096
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite Graph Database
USE_GRAPH_DB=true
SQLITE_GRAPH_DB_PATH=data/code_graph.db

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Monitoring & Tracing
# =============================================================================

# Langfuse (LLM Tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (LLM Tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=java-unit-test-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =============================================================================
# API Configuration
# =============================================================================

# API Server
PYTHON_API_PORT=8000
ADMIN_UI_PORT=5173

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# =============================================================================
# Agent Configuration
# =============================================================================

MAX_CONCURRENT_TASKS=5
AGENT_TIMEOUT=300
ENABLE_GUARDRAILS=true
MAX_RETRY_ATTEMPTS=3
MAX_METHOD_COMPLEXITY=15
BATCH_SIZE=32

# =============================================================================
# Embedding Configuration
# =============================================================================

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# Qdrant Vector Store Configuration
# =============================================================================

QDRANT_DISTANCE_METRIC=Cosine
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_FULL_SCAN_THRESHOLD=10000
# QDRANT_SEARCH_EF=
QDRANT_DEFAULT_LIMIT=20
QDRANT_SCORE_THRESHOLD=0.6
QDRANT_INDEXING_THRESHOLD=1000
QDRANT_ON_DISK_PAYLOAD=false
QDRANT_PRESET=

# =============================================================================
# Performance Configuration
# =============================================================================

CACHE_TTL=3600
WEBSOCKET_RECONNECT_INTERVAL=5000

# =============================================================================
# Application Configuration
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# Getting API Keys
# =============================================================================

# OpenAI: https://platform.openai.com/api-keys
# Qwen: https://dashscope.console.aliyun.com/apiKey
# Anthropic: https://console.anthropic.com/
# Langfuse: https://cloud.langfuse.com/
# LangSmith: https://smith.langchain.com/

