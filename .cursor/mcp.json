{
  "mcpServers": {
    "langsmith": {
      "command": "npx",
      "args": ["-y", "@langchain/langsmith-mcp"],
      "env": {
        "LANGCHAIN_API_KEY": "${LANGCHAIN_API_KEY}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp", "--transport", "stdio"]
    },
    "langchain-docs-mcp": {
      "command": "uvx",
      "args": [
        "--from", "mcpdoc",
        "mcpdoc",
        "--urls", "LangChain:https://python.langchain.com/llms.txt",
        "--transport", "stdio"
      ]
    }
  }
}

